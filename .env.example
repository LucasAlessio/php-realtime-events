# Porta HTTP do servidor (health check + Socket.IO + ingestão)
PORT=4000

# Segredo compartilhado com o PHP para assinar o corpo de /internal/emit (HMAC-SHA256)
INGEST_HMAC_SECRET=change-me-ingest-secret

# Janela de tolerância (segundos) entre o timestamp assinado e o relógio do servidor
INGEST_TIMESTAMP_TOLERANCE_SECONDS=300

# Tamanho máximo aceito do corpo de /internal/emit, em bytes
MAX_BODY_BYTES=1048576

# Segredo compartilhado com o PHP para assinar o JWT do cliente (HS256).
# O PHP assina com os BYTES DECODIFICADOS de um segredo em base64 — não com
# a string base64 em si. JWT_SECRET_ENCODING controla como este servidor
# deriva a chave a partir de JWT_SECRET: "base64" (default) decodifica antes
# de usar; "utf8" trata o valor como texto puro (ambientes legados/testes).
JWT_SECRET=3vKZyK1sj8WGlgo8ohHxdEX8zIPmaJYiP0gIJQ6n
JWT_SECRET_ENCODING=base64

# Origens permitidas para o handshake do Socket.IO (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173

# Opcional: se definido, liga o @socket.io/redis-adapter para suportar múltiplos nós
REDIS_URL=
